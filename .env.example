# docs/배포.md 참고. 복사해서 .env 로 쓰고 값을 채운다. (.env 는 커밋하지 않는다)

# 서비스 주소 (쿠키 · Origin 검사 · 초대 링크에 쓰임). https 면 쿠키에 Secure 가 붙는다
PUBLIC_ORIGIN=https://quiz.example.com

# 콘텐츠 레포 (승인 커밋을 push 하므로 쓰기 권한 필요)
#  - SSH + 배포 키(권장): git@github.com:APSODE/quiz-launcher.git
#  - HTTPS + 토큰: https://x-access-token:<fine-grained 토큰>@github.com/APSODE/quiz-launcher.git
CONTENT_REPO_URL=git@github.com:APSODE/quiz-launcher.git
CONTENT_BRANCH=master

# GitHub webhook 시크릿 (레포 Settings → Webhooks 의 Secret 과 같게). 예: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me

# 승인 커밋 작성자
GIT_AUTHOR_NAME=quiz-server
GIT_AUTHOR_EMAIL=quiz-server@users.noreply.github.com

# 업로드 제한
UPLOAD_MAX_FILE_BYTES=1048576
UPLOAD_MAX_FILES=20
UPLOAD_DAILY_LIMIT=10

# 호스트에서 열 주소 · 포트 (docker-compose.yml)
HOST_BIND=127.0.0.1
HOST_PORT=8787
