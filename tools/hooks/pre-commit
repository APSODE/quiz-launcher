#!/bin/sh
# 커밋 전에 문항을 검사한다(tools/check.js). v2 서버의 업로드 승인 커밋도 이 훅을 거친다.
# v1 실행기 묶음 파일(v1/quiz_bundle.js)은 더 이상 만들지 않는다. 필요하면 직접: node v1/build-bundle.js
# 설치(한 번): git config core.hooksPath tools/hooks
# 검사 오류가 있으면 커밋을 멈춘다. 경고는 보여 주기만 한다. 급할 때 건너뛰기: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node 가 없어 문항 검사를 건너뜁니다. 'node tools/check.js' 를 직접 실행하세요." >&2
  exit 0
fi
if ! node tools/check.js --quiet; then
  echo "[pre-commit] 문항 검사 오류로 커밋을 멈췄습니다. 위 오류를 고치거나, 급하면 git commit --no-verify" >&2
  exit 1
fi
# 운영체제 계산 엔진(스케줄링 · 은행가)을 고친 커밋이면 참조 구현과 비교
if git -c core.quotepath=false diff --cached --name-only | grep -q '^플러그인/운영체제/[12]_' || git -c core.quotepath=false diff --cached --name-only | grep -q '^tools/os-calc.js'; then
  if ! node tools/os-calc.js --self-test 500; then
    echo "[pre-commit] 운영체제 계산 엔진이 참조 구현과 다르게 계산합니다. 커밋을 멈췄습니다." >&2
    exit 1
  fi
fi
# 새로 추가한 문제 파일은 비슷한 문제를 보여 준다(경고만, 커밋은 진행)
NEW=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=A -- '*.jsx' | grep -v '/연습/' | grep -v '^플러그인/')
if [ -n "$NEW" ]; then
  printf '%s\n' "$NEW" | xargs -d '\n' node tools/check.js --dup --quiet | grep -v '^검사 통과' | grep -v '^$'
fi
exit 0
