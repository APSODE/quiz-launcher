#!/bin/sh
# 커밋 전에 문항을 검사하고(tools/check.js), 묶음 파일(quiz_bundle.js)을 다시 만들어 함께 커밋한다.
# 설치(한 번): git config core.hooksPath tools/hooks
# 검사 오류가 있으면 커밋을 멈춘다. 경고는 보여 주기만 한다. 급할 때 건너뛰기: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node 가 없어 문항 검사와 quiz_bundle.js 생성을 건너뜁니다. 'node tools/check.js' · 'node tools/build-bundle.js' 를 직접 실행하세요." >&2
  exit 0
fi
if ! node tools/check.js --quiet; then
  echo "[pre-commit] 문항 검사 오류로 커밋을 멈췄습니다. 위 오류를 고치거나, 급하면 git commit --no-verify" >&2
  exit 1
fi
node tools/build-bundle.js && git add quiz_bundle.js
exit 0
