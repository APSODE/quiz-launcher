#!/bin/sh
# 커밋할 때 묶음 파일(quiz_bundle.js)을 다시 만들어 함께 커밋한다.
# 설치(한 번): git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if command -v node >/dev/null 2>&1; then
  node tools/build-bundle.js && git add quiz_bundle.js
else
  echo "[pre-commit] node 가 없어 quiz_bundle.js 를 다시 만들지 못했습니다. 'node tools/build-bundle.js' 를 직접 실행하세요." >&2
fi
exit 0
